---
import Base from '../layouts/Base.astro';
// Copia tus archivos en public/anexos/ y descríbelos aquí.
const anexos = [
  { titulo: 'Catálogo fotográfico y evidencias de difusión', descripcion: 'Anexo digital del catálogo y registro de su distribución, alojados en Google Drive.', archivo: 'https://drive.google.com/drive/folders/1gfbCKUJgRhC-cRUOTO7gEzUwv7oNUoqH?usp=sharing', tipo: 'Abrir carpeta', externo: true },
];
---
<Base titulo="Anexos">
  <section class="py-8">
    <h1 class="font-serif text-4xl font-bold">Anexos</h1>
    <p class="mb-5">Instrumentos, datos y tablas descargables.</p>
    {anexos.length ? <ul class="grid gap-3 md:grid-cols-2">
      {anexos.map((a) => (
        <li class="flex items-center justify-between gap-3 border border-[#DDD7CA] bg-white p-4">
          <div><b class="font-serif text-lg">{a.titulo}</b><p class="text-[15px]">{a.descripcion}</p></div>
          <a href={a.archivo} download={!a.externo} target={a.externo ? '_blank' : undefined} rel={a.externo ? 'noreferrer' : undefined} class="shrink-0 border border-vino px-4 py-2 font-bold text-vino">{a.tipo}</a>
        </li>
      ))}
    </ul> : <p class="border border-[#DDD7CA] bg-white p-4">Los anexos estarán disponibles aquí cuando se incorporen los archivos finales.</p>}
  </section>
</Base>
