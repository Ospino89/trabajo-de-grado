---
import Base from '../layouts/Base.astro';
import Carrusel from '../components/Carrusel.astro';
import Resumen60 from '../components/Resumen60.astro';
import Perfil from '../components/Perfil.astro';
import DatosClave from '../components/DatosClave.astro';
import { trabajo } from '../data/trabajo';
const slugs = ['1-problema', '2-marco-teorico', '3-propuesta-de-produccion', '4-tecnicas-de-recoleccion-y-analisis'];
---
<Base scholar={true} titulo={trabajo.tituloCorto + ' · Inicio'}>
  <section class="grid items-center gap-10 py-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
    <div>
      <p class="font-bold text-vino">{trabajo.universidad} · {trabajo.anio}</p>
      <h1 class="my-3 font-serif text-4xl font-bold leading-tight md:text-5xl">{trabajo.titulo}</h1>
      <p class="border border-[#DDD7CA] bg-white p-4 text-xl"><b class="text-vino">En una frase:</b> {trabajo.frase}</p>
      <p class="my-4">{trabajo.autores} · Director: {trabajo.director} · {trabajo.programa}</p>
      <div class="flex flex-wrap gap-2.5">
        <a href="#resumen" class="bg-vino px-5 py-2.5 font-bold text-white">Entender en 1 min</a>
        <a href="/capitulos/1-problema" class="border border-vino px-5 py-2.5 font-bold text-vino">Leer completo</a>
        <a href={trabajo.pdf} class="border border-vino px-5 py-2.5 font-bold text-vino">Descargar PDF</a>
      </div>
    </div>
    <Carrusel />
  </section>
  <div id="resumen"><Resumen60 /></div>
  <Perfil />
  <DatosClave />
  <section class="py-6" aria-labelledby="hdoc">
    <h2 id="hdoc" class="mb-3 font-serif text-3xl font-bold">Documento completo</h2>
    <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
      {trabajo.capitulos.map((c, i) => <a href={'/capitulos/' + slugs[i]} class="border border-vino py-2 text-center font-bold text-vino" title={c}>{i + 1}. {c}</a>)}
    </div>
  </section>
</Base>
