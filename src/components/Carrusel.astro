---
import { trabajo } from '../data/trabajo';
const imgs = trabajo.imagenes;
const flecha = 'absolute top-1/2 -mt-[22px] h-11 w-11 rounded-full bg-vino text-white text-2xl leading-none hover:bg-black';
---
<section data-carrusel aria-roledescription="carrusel" aria-label="Piezas fotográficas">
  <div class="relative">
    <div class="overflow-hidden">
      <div data-pista class="flex transition-transform duration-[1200ms] ease-in-out">
        {imgs.map((im, i) => (
          <figure data-slide aria-hidden={i !== 0} data-pie={im.pie + ' · ' + im.credito} class="m-0 w-full shrink-0">
            {im.src
              ? <img src={im.src} alt={im.alt} class="block aspect-[1600/1131] w-full border border-[#CFC8B8] object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
              : <div class="flex aspect-[1.4] items-center justify-center border border-[#CFC8B8] bg-[#E9E5DB]">[Imagen {i + 1}]</div>}
          </figure>
        ))}
      </div>
    </div>
    <button type="button" data-prev aria-label="Imagen anterior" class={flecha + ' left-3'}>‹</button>
    <button type="button" data-next aria-label="Imagen siguiente" class={flecha + ' right-3'}>›</button>
  </div>
  <p data-pie class="mt-1.5 text-sm">{imgs[0].pie} · {imgs[0].credito}</p>
  <p class="mt-1 text-center text-sm" aria-live="polite"><span data-actual>1</span> / {imgs.length}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((root) => {
    const pista = root.querySelector<HTMLElement>('[data-pista]')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const actual = root.querySelector('[data-actual]');
    const pie = root.querySelector('p[data-pie]');
    let i = 0;
    let timer: number | undefined;
    const mostrar = (n: number) => {
      i = (n + slides.length) % slides.length;
      pista.style.transform = `translateX(-${i * 100}%)`;
      slides.forEach((s, k) => s.setAttribute('aria-hidden', String(k !== i)));
      if (pie) pie.textContent = slides[i].dataset.pie || '';
      if (actual) actual.textContent = String(i + 1);
    };
    // Avance automático cada 7 s; se pausa con el mouse, el teclado o si la pestaña está oculta.
    const parar = () => { clearInterval(timer); timer = undefined; };
    const iniciar = () => {
      parar();
      if (slides.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => { if (document.visibilityState === 'visible') mostrar(i + 1); }, 7000);
    };
    root.addEventListener('mouseenter', parar);
    root.addEventListener('mouseleave', iniciar);
    root.addEventListener('focusin', parar);
    root.addEventListener('focusout', iniciar);
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.hasAttribute('data-next')) mostrar(i + 1);
      if (b.hasAttribute('data-prev')) mostrar(i - 1);
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') mostrar(i + 1);
      if (e.key === 'ArrowLeft') mostrar(i - 1);
    });
    iniciar();
  });
</script>
