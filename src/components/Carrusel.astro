---
import { trabajo } from '../data/trabajo';
const imgs = trabajo.imagenes;
const flecha = 'absolute top-1/2 -mt-[22px] h-11 w-11 rounded-full bg-vino text-white text-2xl leading-none hover:bg-black';
---
<section data-carrusel aria-roledescription="carrusel" aria-label="Piezas fotográficas">
  {imgs.map((im, i) => (
    <figure data-slide hidden={i !== 0} class="m-0">
      <div class="relative">
        {im.src
          ? <img src={im.src} alt={im.alt} class="block w-full border border-[#CFC8B8]" loading={i === 0 ? 'eager' : 'lazy'} />
          : <div class="flex aspect-[1.4] items-center justify-center border border-[#CFC8B8] bg-[#E9E5DB]">[Imagen {i + 1}]</div>}
        <button type="button" data-prev aria-label="Imagen anterior" class={flecha + ' left-3'}>‹</button>
        <button type="button" data-next aria-label="Imagen siguiente" class={flecha + ' right-3'}>›</button>
      </div>
      <figcaption class="mt-1.5 text-sm">{im.pie} · {im.credito}</figcaption>
    </figure>
  ))}
  <p class="mt-1 text-center text-sm" aria-live="polite"><span data-actual>1</span> / {imgs.length}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const actual = root.querySelector('[data-actual]');
    let i = 0;
    const mostrar = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => (s.hidden = k !== i));
      if (actual) actual.textContent = String(i + 1);
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.hasAttribute('data-next')) mostrar(i + 1);
      if (b.hasAttribute('data-prev')) mostrar(i - 1);
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') mostrar(i + 1);
      if (e.key === 'ArrowLeft') mostrar(i - 1);
    });
  });
</script>
