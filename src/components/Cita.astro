---
const { apa, bib, id } = Astro.props;
const btn = 'mt-1 border border-vino px-3 py-1 text-sm font-bold text-vino';
---
<section aria-labelledby={id + '-t'} class="border border-[#DDD7CA] bg-white p-3 text-sm">
  <h2 id={id + '-t'} class="font-serif text-lg font-bold">Citar este capítulo</h2>
  <p class="mt-2 font-bold">APA 7</p>
  <pre id={id + '-apa'} class="whitespace-pre-wrap font-sans">{apa}</pre>
  <button type="button" data-copiar={id + '-apa'} class={btn}>Copiar APA</button>
  <p class="mt-3 font-bold">BibTeX</p>
  <pre id={id + '-bib'} class="whitespace-pre-wrap font-sans">{bib}</pre>
  <button type="button" data-copiar={id + '-bib'} class={btn}>Copiar BibTeX</button>
</section>
